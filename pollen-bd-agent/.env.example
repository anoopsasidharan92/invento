# .env — Copy this to .env and fill in your keys
# NEVER commit this file to git.

# Required: Anthropic API key (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Required: Serper.dev API key for web search (free: 2500/month at serper.dev)
SERPER_API_KEY=...

# Optional: mirror qualified leads to PostgreSQL (same JSON as leads.json).
# Easiest: copy repo-root postgres.env.example to ../.env and run ../scripts/start-local-postgres.sh
# POSTGRES_URL=postgresql+psycopg2://agents:agents_local_dev_only@127.0.0.1:5432/agents
