# Extra browser origins allowed to call this API, comma-separated.
# Local dev ports (5173/5174/3000) are always allowed.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional regex for Vercel preview deployments (new subdomain per build).
# ALLOWED_ORIGIN_REGEX=https://.*-yourteam\.vercel\.app

# Anthropic API key, if the backend calls Claude directly.
# ANTHROPIC_API_KEY=sk-ant-...
