# Repo-root secrets (e.g. POSTGRES_URL from postgres.env.example)
/.env

venv/
.venv/
__pycache__/
*.pyc
.DS_Store

frontend/node_modules/
frontend/dist/

backend/uploads/
backend/outputs/
backend/inventory.db
backend/*.db.bak*
backend/*.log
uploads/
outputs/
backend/.venv/
backend/context_memory.json

# Agent secrets and top-level user state — never committed
pollen-bd-agent/config.json
pollen-bd-agent/data/
pollen-bd-agent/.env
real-estate-agent/.env
sales-deal-agent/.env

# Agent run output (leads, listings, search history, status, lineage).
# Regenerated on every run — per-project config.json stays tracked.
pollen-bd-agent/projects/*/data/
real-estate-agent/projects/*/data/
sales-deal-agent/projects/*/data/

*.log
