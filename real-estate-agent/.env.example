# .env — Your private API keys. Never committed to git.

# Required: Serper.dev API key for web search (serper.dev — 2500 free searches/month)
SERPER_API_KEY=your_serper_api_key_here

# Optional: mirror saved listings to PostgreSQL (same JSON as listings.json).
# Easiest: copy repo-root postgres.env.example to ../.env and run ../scripts/start-local-postgres.sh
# POSTGRES_URL=postgresql+psycopg2://agents:agents_local_dev_only@127.0.0.1:5432/agents
